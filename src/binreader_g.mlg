DECLARE PLUGIN "coq-binreader.plugin"

{
  open Stdarg
}

VERNAC COMMAND EXTEND LoadIntArray CLASSIFIED AS SIDEFF
| [ "LoadData" string(filename) "As" ident(x) ] -> {
    Binreader.load_and_define_data_from_file filename x
  }
END

VERNAC COMMAND EXTEND LoadPackedData CLASSIFIED AS SIDEFF
| [ "LoadDataPacked" string(filename) "As" ident(x) ] -> {
    Binreader.load_and_define_packed_data_from_file filename x
  }
END
